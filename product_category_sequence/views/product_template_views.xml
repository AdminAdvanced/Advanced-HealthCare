<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="product_template_form_sequence" model="ir.ui.view">

        <field name="name">product.template.form.sequence</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!--
                فلترة الكاتجوري:
                يظهر فقط Categories التي عليها Sequence
            -->
            <xpath expr="//field[@name='categ_id']" position="attributes">

                <attribute name="domain">
                    [('is_sequence_category','=',True)]
                </attribute>


            </xpath>



            <!--
                منع تعديل Internal Reference
                لكل المستخدمين
            -->
            <xpath expr="//field[@name='default_code']"
                   position="attributes">


                <attribute name="readonly">
                    1
                </attribute>


            </xpath>


        </field>


    </record>


</odoo>