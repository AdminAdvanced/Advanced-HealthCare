<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Form View -->
    <record id="account_group_form_parent_level" model="ir.ui.view">
        <field name="name">account.group.form.parent.level</field>
        <field name="model">account.group</field>
        <field name="inherit_id" ref="account.view_account_group_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <field name="x_parent_id"/>
                <field name="level" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Custom Tree View (NO inherit) -->
    <record id="account_group_list_parent_level" model="ir.ui.view">
        <field name="name">account.group.list.parent.level</field>
        <field name="model">account.group</field>
        <field name="arch" type="xml">
            <list default_order="level asc">
                <field name="name"/>
                <field name="x_parent_id"/>
                <field name="level"/>
            </list>
        </field>
    </record>

    <record id="action_account_group_custom_tree" model="ir.actions.act_window">
        <field name="name">Account Groups</field>
        <field name="res_model">account.group</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account_group_list_parent_level"/>
    </record>

</odoo>
