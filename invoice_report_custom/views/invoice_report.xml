    <!-- اخفاء تيبل اللوت الاصلي  -->
    <template id="hide_original_lot_table"
              inherit_id="l10n_gcc_invoice_stock_account.arabic_english_invoice_with_snln"
              priority="998">

        <xpath expr="//table[@name='invoice_snln_table']"
               position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

    </template>


    <!-- حذف التاريخ و الوقت للطباعه -->
    <template id="remove_print_datetime"
              inherit_id="l10n_sa.arabic_english_invoice"
              priority="999">

        <xpath expr="//t[@t-set='additional_footer_text']"
               position="attributes">
            <attribute name="t-value">''</attribute>
        </xpath>

    </template>


    <!-- تعديل الجزء الاخير من الفاتوره -->
    <template id="custom_invoice_bottom_layout"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice">

        <xpath expr="//div[@id='total']" position="replace">
            <div class="row mt-n3">

                <!-- LEFT SIDE -->
                <div class="col-6">

                    <!-- Amount words -->
                    <p class="lh-sm"
                       t-if="o.company_id.display_invoice_amount_total_words">
                        Total amount in words:
                        <br/>
                        <span class="text-muted"
                              t-field="o.amount_total_words"/>
                    </p>

                    <p class="lh-sm"
                       t-if="o.company_id.display_invoice_amount_total_words">
                        المبلغ الإجمالي
                        <br/>
                        <span class="text-muted"
                              t-out="o._num2words(o.amount_total, 'ar_001')"/>
                    </p>


                    <!-- Payment Reference -->
                    <div class="row"
                         t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference">

                        <div class="col-6">
                            <strong>
                                Payment Reference:
                            </strong>
                        </div>

                        <div class="col-6">
                            <span t-field="o.payment_reference"/>
                        </div>

                    </div>


                    <!-- Payment Terms -->
                    <p t-if="o.invoice_payment_term_id"
                       name="payment_term">
                        <span t-out="o.invoice_payment_term_id.note"/>
                    </p>


                    <!-- Notes -->
                    <p t-if="o.narration">
                        <span t-out="o.narration"/>
                    </p>

                </div>


                <!-- RIGHT SIDE TOTAL TABLE -->
                <div class="col-6">

                    <table class="o_total_table table table-borderless">

                        <tr>
                            <td class="text-end">
                                <span t-field="o.amount_untaxed"/>
                            </td>

                            <td>
                                <strong>
                                    Subtotal /
                                    الإجمالي الفرعي
                                </strong>
                            </td>
                        </tr>


                        <t t-set="tax_totals"
                           t-value="o.tax_totals"/>

                        <t t-set="currency"
                           t-value="o.currency_id"/>


                        <t t-foreach="tax_totals['subtotals']"
                           t-as="subtotal">

                            <t t-foreach="subtotal['tax_groups']"
                               t-as="tax_group">

                                <tr>
                                    <td class="text-end">
                                        <span t-out="tax_group['tax_amount_currency']"
                                              t-options="{'widget':'monetary',
                                              'display_currency':currency}"/>
                                    </td>

                                    <td>
                                        <span t-out="tax_group['group_name']"/>
                                    </td>

                                </tr>

                            </t>

                        </t>


                        <tr class="o_total">
                            <td class="text-end">
                                <span t-field="o.amount_total"/>
                            </td>

                            <td>
                                <strong>
                                    Total /
                                    المجموع
                                </strong>
                            </td>
                        </tr>

                    </table>

                </div>

            </div>

        </xpath>

    </template>

</odoo>
