    <!-- تغيرات بتصميم الخط و حجمه -->
    <template id="invoice_font_custom"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice"
              priority="100">

        <xpath expr="//div[hasclass('page')]" position="inside">

            <style>

                /* ==========================================================
                   GENERAL FONT
                   ========================================================== */

                .page{
                    font-family: Arial, sans-serif !important;
                    font-size:8pt;
                }

                /* ==========================================================
                   MAIN PRODUCT TABLE ONLY
                   ========================================================== */

                table[name="invoice_line_table"]{
                    width:100% !important;
                    table-layout:fixed;
                }

                /* Header */

                table[name="invoice_line_table"] thead th{
                    font-size:10pt !important;
                    font-weight:normal !important;
                    font-family:Arial,sans-serif !important;

                    padding-top:3px !important;
                    padding-bottom:3px !important;

                    vertical-align:middle;
                }
                table[name="invoice_line_table"] thead th,
                table[name="invoice_line_table"] thead th span {
                    text-transform: none !important;
                }
                table[name="invoice_line_table"] thead th,
                table[name="invoice_line_table"] thead th *,
                table[name="invoice_line_table"] thead th span,
                table[name="invoice_line_table"] thead th strong{
                    font-size:8pt !important;
                    font-weight:normal !important;
                    text-transform:none !important;
                    font-family:Arial,sans-serif !important;
                }
                /* Body */

                table[name="invoice_line_table"] tbody td{

                    font-size:8pt !important;
                    font-weight:normal !important;
                    font-family:Arial,sans-serif !important;

                    padding-top:2px !important;
                    padding-bottom:2px !important;

                    vertical-align:top !important;
                }

                /* ==========================================================
                   COLUMN WIDTHS
                   ========================================================== */

                /* Description */

                table[name="invoice_line_table"] th[name="th_description"]{
                    width:28% !important;
                }

                /* Quantity */

                table[name="invoice_line_table"] th[name="th_quantity"]{
                    width:7% !important;
                }

                /* Unit Price */

                table[name="invoice_line_table"] th[name="th_priceunit"]{
                    width:9% !important;
                }

                /* Discount */

                table[name="invoice_line_table"] th[name="th_price_unit"]{
                    width:6% !important;
                }

                /* Taxes */

                table[name="invoice_line_table"] th[name="th_taxes"]{
                    width:8% !important;
                }

                /* Amount */

                table[name="invoice_line_table"] th[name="th_subtotal"]{
                    width:10% !important;
                }

                /* VAT Amount */

                table[name="invoice_line_table"] th[name="th_tax_amount"]{
                    width:10% !important;
                }

                /* Total */

                table[name="invoice_line_table"] th[name="th_total"]{
                    width:10% !important;
                }

                /* ==========================================================
                   YOUR CUSTOM COLUMNS
                   ========================================================== */

                table[name="invoice_line_table"] th[name="th_lot"]{
                    width:12% !important;
                }

                table[name="invoice_line_table"] th[name="th_lot_qty"]{
                    width:10% !important;
                }

                /* ==========================================================
                   PRODUCT TABLE ROW HEIGHT
                   ========================================================== */

                table[name="invoice_line_table"] td{

                    line-height:16px !important;

                }

                /* ==========================================================
                   KEEP NUMBERS ON ONE LINE
                   ========================================================== */

                .text-nowrap{
                    white-space:nowrap !important;
                }

                /* ==========================================================
                   TOTAL TABLE
                   DON'T TOUCH ITS LAYOUT
                   ========================================================== */

                #total table{

                    table-layout:auto !important;
                    width:auto !important;

                }

                #total td,
                #total th{

                    font-size:8pt !important;
                    font-family:Arial,sans-serif !important;

                }
            </style>

        </xpath>

    </template>


    <!-- اضافه اسم العميل بالعربي تحت اسمه بالانجليزي  -->
    <template id="invoice_report_custom"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice"
              priority="99">
        <!-- تغير نوع الخط الفاتوره -->
            <xpath expr="//div[hasclass('page')]" position="attributes">
                    <attribute name="class" add=" ar-font" separator=" "/>
            </xpath>

        <xpath expr="//t[@t-set='address']/address" position="replace">

            <address class="mb-0"
                     style="text-align:right">

                <!-- English Name -->
                <div>
                    <span t-field="o.partner_id.name"/>
                </div>

                <!-- Arabic Name -->
                <div t-if="o.partner_id.x_studio_name_ar"
                     style="direction:rtl;">
                    <span t-field="o.partner_id.x_studio_name_ar"/>
                </div>

                <!-- Address -->
                <div t-field="o.partner_id"
                     t-options="{
                        'widget': 'contact',
                        'fields': ['address'],
                        'no_marker': True
                     }"/>

            </address>

        </xpath>

    </template>


    <!-- تصغير حجم QR Code  -->
    <template id="invoice_qr_size_custom"
              inherit_id="l10n_sa.arabic_english_invoice"
              priority="99">

        <xpath expr="//img[contains(@t-att-src, 'l10n_sa_qr_code_str')]"
               position="attributes">

            <attribute name="class">
                d-block qr_small
            </attribute>

        </xpath>

    </template>


    <!--   توسيط البيانات و تعديل مكان title en  -->
    <template id="invoice_information_custom"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice"
              priority="99">

        <xpath expr="//div[@id='informations']" position="replace">

            <div id="informations"
                 class="pb-3"
                 t-if="o.invoice_date or (o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted') or o.delivery_date or o.invoice_origin or o.ref">

                <!-- Invoice Date -->
                <div class="row mb-1" t-if="o.invoice_date">
                    <div class="col-4 text-start">
                        <strong>Invoice Date:</strong>
                    </div>
                    <div class="col-4 text-center">
                        <span t-field="o.invoice_date"/>
                    </div>
                    <div class="col-4 text-end">
                        <strong>: تاريخ الفاتورة</strong>
                    </div>
                </div>

                <!-- Due Date -->
                <div class="row mb-1"
                     t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'">
                    <div class="col-4 text-start">
                        <strong>Due Date:</strong>
                    </div>
                    <div class="col-4 text-center">
                        <span t-field="o.invoice_date_due"/>
                    </div>
                    <div class="col-4 text-end">
                        <strong>: تاريخ الاستحقاق</strong>
                    </div>
                </div>

                <!-- Supply Date -->
                <div class="row mb-1" t-if="o.delivery_date">
                    <div class="col-4 text-start">
                        <strong>Supply Date:</strong>
                    </div>
                    <div class="col-4 text-center">
                        <span t-out="o.delivery_date.strftime('%m/%d/%Y')"/>
                    </div>
                    <div class="col-4 text-end">
                        <strong>: تاريخ التوريد</strong>
                    </div>
                </div>

                <!-- Source -->
                <div class="row mb-1" t-if="o.invoice_origin">
                    <div class="col-4 text-start">
                        <strong>Source:</strong>
                    </div>
                    <div class="col-4 text-center">
                        <span t-field="o.invoice_origin"/>
                    </div>
                    <div class="col-4 text-end">
                        <strong>: المصدر</strong>
                    </div>
                </div>

                <!-- Reference -->
                <div class="row mb-1" t-if="o.ref">
                    <div class="col-4 text-start">
                        <strong>Reference:</strong>
                    </div>
                    <div class="col-4 text-center">
                        <span t-field="o.ref"/>
                    </div>
                    <div class="col-4 text-end">
                        <strong>: رقم الإشارة</strong>
                    </div>
                </div>

            </div>

        </xpath>

    </template>


    <!--  اضافه الوحده و الديسكربشن بالعربي للجدول  -->
    <template id="invoice_quantity_uom"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice"
              priority="99">

        <!-- Quantity -->
        <xpath expr="//td[hasclass('o_td_quantity')]" position="replace">
            <td class="o_td_quantity text-end">
                <span t-field="line.quantity"/>
                <span t-field="line.product_uom_id"/>
                /
                <span t-field="line.product_uom_id.x_studio_unit_of_measure_ar"/>
            </td>

        </xpath>

        <!-- Description -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="replace">

            <td class="text-end" name="account_invoice_line_name">

                <span t-field="line.product_id.name"/>
                <div style="direction: rtl; text-align: right;">
                    <t t-if="line.product_id.x_studio_product_name_ar">
                        <br/>
                        <span t-field="line.product_id.x_studio_product_name_ar"/>
                    </t>
                </div>
            </td>
        </xpath>
    </template>


    <!--  اضافه Lot و Lot Qty للجدول الاساسي -->
    <template id="invoice_lot_column"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice"
              priority="99">

        <!-- Lot Headers -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_lot_qty" class="text-center">
                <span>Lot Qty</span>
                <br/>
                <span>كمية اللوت</span>
            </th>
            <th name="th_lot" class="text-center">
                <span>SN/Lot</span>
                <br/>
                <span>رقم التسلسل/لوت</span>
            </th>
        </xpath>


        <!-- Lot Columns -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="before">

            <!-- LOT QTY -->
            <td class="text-center align-middle"
                style="padding:0; vertical-align:top;">

                <t t-set="lots"
                   t-value="o.get_invoice_line_lots(line) or []"/>

                <t t-foreach="lots" t-as="lot">

                    <div t-att-style="
                        'height:30px;
                         line-height:30px;
                         white-space:nowrap;
                         overflow:hidden;
                         text-align:center;
                         font-family:Arial, sans-serif;
                         font-size:8pt;
                         font-weight:normal;
                         border-bottom:' +
                         ('0px' if lot_last else '1px') +
                         ' solid #999;'
                    ">
                        <span t-esc="lot['quantity']"/>
                        <span t-esc="lot['uom_name']"/>
                    </div>

                </t>

            </td>

            <!-- SN / LOT -->
            <td class="text-center align-middle"
                style="padding:0; vertical-align:top;">

                <t t-set="lots"
                   t-value="o.get_invoice_line_lots(line) or []"/>

                <t t-foreach="lots" t-as="lot">

                    <div t-att-style="
                        'height:30px;
                         line-height:30px;
                         white-space:nowrap;
                         overflow:hidden;
                         text-align:center;
                         font-family:Arial, sans-serif;
                         font-size:8pt;
                         font-weight:normal;
                         border-bottom:' +
                         ('0px' if lot_last else '1px') +
                         ' solid #999;'
                    ">
                        <span t-esc="lot['lot_name']"/>
                    </div>

                </t>

            </td>
        </xpath>

    </template>


    <!--  تعديل التايتل على للجدول الاساسي -->
    <template id="invoice_headers_custom"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice"
              priority="101">

        <!-- Description -->
        <xpath expr="//th[@name='th_description']" position="replace">
            <th name="th_description" class="text-center">
                <span>Product Description</span>
                <br/>
                <span>وصف المنتج</span>
            </th>
        </xpath>

        <!-- Quantity -->
        <xpath expr="//th[@name='th_quantity']" position="replace">
            <th name="th_quantity" class="text-center">
                <span>Qty</span>
                <br/>
                <span>الكمية</span>
            </th>
        </xpath>

        <!-- Unit Price -->
        <xpath expr="//th[@name='th_priceunit']" position="replace">
            <th name="th_priceunit" class="text-center">
                <span>Unit Price</span>
                <br/>
                <span>سعر الوحدة</span>
            </th>
        </xpath>

        <!-- Taxes -->
        <xpath expr="//th[@name='th_taxes']" position="replace">
            <th name="th_taxes" class="text-center">
                <span>Taxes</span>
                <br/>
                <span>نسبة الضريبة</span>
            </th>
        </xpath>

        <!-- Amount -->
        <xpath expr="//th[@name='th_subtotal']" position="replace">
            <th name="th_subtotal" class="text-center">
                <span>Total Exclusive Of Vat</span>
                <br/>
                <span>المجموع بدون الضريبة</span>
            </th>
        </xpath>

        <!-- VAT Amount -->
        <xpath expr="//th[@name='th_tax_amount']" position="replace">
            <th name="th_tax_amount" class="text-center">
                <span>VAT Amount</span>
                <br/>
                <span>قيمة الضريبة</span>
            </th>
        </xpath>

        <!-- Total -->
        <xpath expr="//th[@name='th_total']" position="replace">
            <th name="th_total" class="text-center">
                <span>Total Inclusive Of Vat</span>
                <br/>
                <span>المجموع شامل ضريبة القيمة المضافة</span>
            </th>
        </xpath>

    </template>
