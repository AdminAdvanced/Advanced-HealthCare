<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- اضافه اسم العميل بالعربي تحت اسمه بالانجليزي  -->
    <template id="invoice_report_custom"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice"
              priority="99">

        <xpath expr="//t[@t-set='address']/address" position="replace">

            <address class="mb-0"
                     style="text-align:right">

                <!-- English Name -->
                <div>
                    <span t-field="o.partner_id.name"/>
                </div>

                <!-- Arabic Name -->
                <div t-if="o.partner_id.x_studio_name_ar"
                     style="direction:rtl;">
                    <span t-field="o.partner_id.x_studio_name_ar"/>
                </div>

                <!-- Address -->
                <div t-field="o.partner_id"
                     t-options="{
                        'widget': 'contact',
                        'fields': ['address'],
                        'no_marker': True
                     }"/>

            </address>

        </xpath>

    </template>


    <!-- تصغير حجم QR Code  -->
    <template id="invoice_qr_size_custom"
              inherit_id="l10n_sa.arabic_english_invoice"
              priority="99">

        <xpath expr="//img[contains(@t-att-src, 'l10n_sa_qr_code_str')]"
               position="attributes">

            <attribute name="class">
                d-block qr_small
            </attribute>

        </xpath>

    </template>


    <!--   توسيط البيانات و تعديل مكان title en  -->
    <template id="invoice_information_custom"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice"
              priority="99">

        <xpath expr="//div[@id='informations']" position="replace">

            <div id="informations"
                 class="pb-3"
                 t-if="o.invoice_date or (o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted') or o.delivery_date or o.invoice_origin or o.ref">

                <!-- Invoice Date -->
                <div class="row mb-1" t-if="o.invoice_date">
                    <div class="col-4 text-start">
                        <strong>Invoice Date:</strong>
                    </div>
                    <div class="col-4 text-center">
                        <span t-field="o.invoice_date"/>
                    </div>
                    <div class="col-4 text-end">
                        <strong>: تاريخ الفاتورة</strong>
                    </div>
                </div>

                <!-- Due Date -->
                <div class="row mb-1"
                     t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'">
                    <div class="col-4 text-start">
                        <strong>Due Date:</strong>
                    </div>
                    <div class="col-4 text-center">
                        <span t-field="o.invoice_date_due"/>
                    </div>
                    <div class="col-4 text-end">
                        <strong>: تاريخ الاستحقاق</strong>
                    </div>
                </div>

                <!-- Supply Date -->
                <div class="row mb-1" t-if="o.delivery_date">
                    <div class="col-4 text-start">
                        <strong>Supply Date:</strong>
                    </div>
                    <div class="col-4 text-center">
                        <span t-out="o.delivery_date.strftime('%m/%d/%Y')"/>
                    </div>
                    <div class="col-4 text-end">
                        <strong>: تاريخ التوريد</strong>
                    </div>
                </div>

                <!-- Source -->
                <div class="row mb-1" t-if="o.invoice_origin">
                    <div class="col-4 text-start">
                        <strong>Source:</strong>
                    </div>
                    <div class="col-4 text-center">
                        <span t-field="o.invoice_origin"/>
                    </div>
                    <div class="col-4 text-end">
                        <strong>: المصدر</strong>
                    </div>
                </div>

                <!-- Reference -->
                <div class="row mb-1" t-if="o.ref">
                    <div class="col-4 text-start">
                        <strong>Reference:</strong>
                    </div>
                    <div class="col-4 text-center">
                        <span t-field="o.ref"/>
                    </div>
                    <div class="col-4 text-end">
                        <strong>: رقم الإشارة</strong>
                    </div>
                </div>

            </div>

        </xpath>

    </template>


    <!--  اضافه الوحده و الديسكربشن بالعربي للجدول  -->
    <template id="invoice_quantity_uom"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice"
              priority="99">

        <!-- Quantity -->
        <xpath expr="//td[hasclass('o_td_quantity')]" position="replace">
            <td class="o_td_quantity text-end">
                <span t-field="line.quantity"/>
                <span t-field="line.product_uom_id"/>
                /
                <span t-field="line.product_uom_id.x_studio_unit_of_measure_ar"/>
            </td>

        </xpath>

        <!-- Description -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="replace">

            <td class="text-end" name="account_invoice_line_name">

                <span t-field="line.product_id.name"/>
                <div style="direction: rtl; text-align: right;">
                    <t t-if="line.product_id.x_studio_product_name_ar">
                        <br/>
                        <span t-field="line.product_id.x_studio_product_name_ar"/>
                    </t>
                </div>
            </td>
        </xpath>
    </template>


    <!-- تعديل تيبل اللوت  -->
    <template id="edit_lot_table"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice"
              priority="999">

        <xpath expr="//div[@id='total']" position="after">

            <t groups="stock_account.group_lot_on_invoice">
                <t t-set="lot_values" t-value="o._get_invoiced_lot_values()"/>

                <t t-if="lot_values">
                    <br/>

                    <table class="table table-sm" style="width: 50%;" name="invoice_snln_table">

                        <thead>
                            <tr>
                                <th>
                                    <span>Product</span>
                                    <br/>
                                    <span>المنتج</span>
                                </th>
                                <th class="text-end">
                                    <span>SN/Lot</span>
                                    <br/>
                                    <span>رقم التسلسل\لوت</span>
                                </th>
                                <th class="text-end">
                                    <span>Quantity</span>
                                    <br/>
                                    <span>الكمية</span>
                                </th>
                            </tr>
                        </thead>


                        <tbody>
                            <t t-foreach="lot_values" t-as="snln_line">

                                <tr>

                                    <td>
                                        <div>
                                            <t t-esc="snln_line['product_name']"/>
                                        </div>

                                        <div>
                                            <t t-esc="snln_line['product_name_ar']"/>
                                        </div>
                                    </td>

                                    <td class="text-end">
                                        <t t-esc="snln_line['lot_name']"/>
                                    </td>

                                    <td class="text-end">

                                        <t t-esc="snln_line['quantity']"/>

                                        <br/>

                                        <t t-esc="snln_line['uom_name']"/>

                                        <br/>

                                        <t t-esc="snln_line['uom_name_ar']"/>

                                    </td>

                                </tr>

                            </t>
                        </tbody>

                    </table>

                </t>

            </t>

        </xpath>

    </template>

    <!-- اخفاء تيبل اللوت الاصلي  -->
    <template id="hide_original_lot_table"
              inherit_id="l10n_gcc_invoice_stock_account.arabic_english_invoice_with_snln"
              priority="998">

        <xpath expr="//table[@name='invoice_snln_table']"
               position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

    </template>

    <!-- حذف التاريخ و الوقت للطباعه -->
    <template id="remove_print_datetime"
              inherit_id="l10n_sa.arabic_english_invoice"
              priority="999">

        <xpath expr="//t[@t-set='additional_footer_text']"
               position="attributes">
            <attribute name="t-value">''</attribute>
        </xpath>

    </template>
</odoo>