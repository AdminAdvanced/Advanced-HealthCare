<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- اضافه اسم العميل بالعربي تحت اسمه بالانجليزي  -->
    <template id="invoice_report_custom"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice"
              priority="99">

        <xpath expr="//t[@t-set='address']/address" position="replace">

            <address class="mb-0"
                     style="text-align:right">

                <!-- English Name -->
                <div>
                    <span t-field="o.partner_id.name"/>
                </div>

                <!-- Arabic Name -->
                <div t-if="o.partner_id.x_studio_name_ar"
                     style="direction:rtl;">
                    <span t-field="o.partner_id.x_studio_name_ar"/>
                </div>

                <!-- Address -->
                <div t-field="o.partner_id"
                     t-options="{
                        'widget': 'contact',
                        'fields': ['address'],
                        'no_marker': True
                     }"/>

            </address>

        </xpath>

    </template>


    <!-- تصغير حجم QR Code  -->
    <template id="invoice_qr_size_custom"
              inherit_id="l10n_sa.arabic_english_invoice"
              priority="99">

        <xpath expr="//img[contains(@t-att-src, 'barcode_type')]" position="attributes">

            <attribute name="style">
                width:80px !important;
                height:80px !important;
            </attribute>

        </xpath>

    </template>

</odoo>