<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- اضافه اسم العميل بالعربي تحت اسمه بالانجليزي  -->
    <template id="invoice_report_custom"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice"
              priority="99">

        <xpath expr="//t[@t-set='address']/address" position="replace">

            <address class="mb-0"
                     style="text-align:right">

                <!-- English Name -->
                <div>
                    <span t-field="o.partner_id.name"/>
                </div>

                <!-- Arabic Name -->
                <div t-if="o.partner_id.x_studio_name_ar"
                     style="direction:rtl;">
                    <span t-field="o.partner_id.x_studio_name_ar"/>
                </div>

                <!-- Address -->
                <div t-field="o.partner_id"
                     t-options="{
                        'widget': 'contact',
                        'fields': ['address'],
                        'no_marker': True
                     }"/>

            </address>

        </xpath>

    </template>


    <!-- تصغير حجم QR Code  -->
    <template id="invoice_qr_size_custom"
              inherit_id="l10n_sa.arabic_english_invoice"
              priority="99">

        <xpath expr="//img[contains(@t-att-src, 'l10n_sa_qr_code_str')]"
               position="attributes">

            <attribute name="class">
                d-block qr_small
            </attribute>

        </xpath>

    </template>


    <!--   توسيط البيانات و تعديل مكان title en  -->
    <template id="invoice_info_alignment"
              inherit_id="l10n_gcc_invoice.arabic_english_invoice"
              priority="99">

        <!-- English titles -->
        <xpath expr="//div[@name='invoice_date']/div[1]" position="attributes">
            <attribute name="class">col-2 offset-6 text-start</attribute>
        </xpath>

        <xpath expr="//div[@name='due_date']/div[1]" position="attributes">
            <attribute name="class">col-2 offset-6 text-start</attribute>
        </xpath>

        <xpath expr="//div[@name='origin']/div[1]" position="attributes">
            <attribute name="class">col-2 offset-6 text-start</attribute>
        </xpath>

        <xpath expr="//div[@name='reference']/div[1]" position="attributes">
            <attribute name="class">col-2 offset-6 text-start</attribute>
        </xpath>

        <!-- Values -->
        <xpath expr="//div[@name='invoice_date']/div[2]" position="attributes">
            <attribute name="class">col-2 text-center</attribute>
        </xpath>

        <xpath expr="//div[@name='due_date']/div[2]" position="attributes">
            <attribute name="class">col-2 text-center</attribute>
        </xpath>

        <xpath expr="//div[@name='origin']/div[2]" position="attributes">
            <attribute name="class">col-2 text-center</attribute>
        </xpath>

        <xpath expr="//div[@name='reference']/div[2]" position="attributes">
            <attribute name="class">col-2 text-center</attribute>
        </xpath>

    </template>


</odoo>