<?xml version="1.0" encoding="UTF-8"?>
 <odoo>

    <!--  اضافه اسم العميل بالعربي  -->
    <template id="invoice_report_custom"
              inherit_id="account.report_invoice_document">

        <xpath expr="//address[@t-field='o.partner_id']"
               position="after">

            <div t-if="o.partner_id.x_studio_name_ar"
                 style="margin-top:2px;font-weight:bold;">

                <span t-field="o.partner_id.x_studio_name_ar"/>

            </div>

        </xpath>

    </template>

</odoo>