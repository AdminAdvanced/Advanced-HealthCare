<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="paperformat_invoice_landscape" model="report.paperformat">
        <field name="name">Invoice Landscape</field>

        <field name="default" eval="False"/>

        <field name="format">A4</field>

        <field name="orientation">Landscape</field>

        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>

        <field name="header_spacing">5</field>

        <field name="dpi">90</field>

    </record>
    <!-- Attach it only to Customer Invoice report -->
    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id" ref="invoice_report_custom.paperformat_invoice_landscape"/>
    </record>

</odoo>