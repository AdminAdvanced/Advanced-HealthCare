<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="company_information_logo"
              inherit_id="account_reports.company_information">

        <xpath expr="//div[@class='row']" position="before">

            <div class="mb-3">
                <img t-if="env.company.logo"
                     t-att-src="'/web/image/res.company/%s/logo' % env.company.id"
                     style="max-height:70px;"/>
            </div>

        </xpath>

    </template>

</odoo>