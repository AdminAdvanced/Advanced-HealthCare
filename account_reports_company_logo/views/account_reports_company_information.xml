<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Accounting Reports -->
    <template id="pdf_export_main_logo"
              inherit_id="account_reports.pdf_export_main">

        <xpath expr="//header/div[hasclass('o_title')]" position="before">

            <div class="d-flex justify-content-end mb-4">
                <img t-if="env.company.logo"
                     t-att-src="'/web/image/res.company/%s/logo' % env.company.id"
                     style="max-height:90px; max-width:220px;"/>
            </div>

        </xpath>

    </template>

    <!-- Customer Statement -->
    <template id="pdf_export_main_customer_logo"
              inherit_id="account_reports.pdf_export_main_customer_report">

        <xpath expr="//header/div[hasclass('o_title')]" position="before">

            <div class="d-flex justify-content-end mb-4">
                <img t-if="env.company.logo"
                     t-att-src="'/web/image/res.company/%s/logo' % env.company.id"
                     style="max-height:90px; max-width:220px;"/>
            </div>

        </xpath>

    </template>

</odoo>