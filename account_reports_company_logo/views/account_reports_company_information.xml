<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Accounting Reports                                         -->
    <!-- ========================================================= -->

    <template id="company_information_logo"
              inherit_id="account_reports.company_information">

        <xpath expr="//div[hasclass('row')]" position="before">

            <div class="d-flex justify-content-end mb-4">

                <img t-if="env.company.logo"
                     t-att-src="'/web/image/res.company/%s/logo' % env.company.id"
                     style="max-height:90px; max-width:250px;"/>

            </div>

        </xpath>

    </template>


    <!-- ========================================================= -->
    <!-- Customer Statement                                         -->
    <!-- ========================================================= -->

    <template id="company_information_customer_logo"
              inherit_id="account_reports.company_information_customer_report">

        <xpath expr="//div[hasclass('row')]" position="before">

            <div class="d-flex justify-content-end mb-4">

                <img t-if="env.company.logo"
                     t-att-src="'/web/image/res.company/%s/logo' % env.company.id"
                     style="max-height:90px; max-width:250px;"/>

            </div>

        </xpath>

    </template>

</odoo>