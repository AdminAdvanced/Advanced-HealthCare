<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->

    <record id="sup_customer_tree" model="ir.ui.view">

        <field name="name">sup.sales.customer.list</field>
        <field name="model">sup.sales.customer</field>

        <field name="arch" type="xml">

            <list>

                <field name="name"/>
                <field name="company_type"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="vat"/>
                <field name="email"/>

            </list>

        </field>

    </record>


    <!-- Form View -->

    <record id="sup_customer_form" model="ir.ui.view">

        <field name="name">sup.sales.customer.form</field>
        <field name="model">sup.sales.customer</field>

        <field name="arch" type="xml">
            <form>

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_quotations"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">

                            <field name="quotation_count"
                                   widget="statinfo"
                                   string="Quotations"/>

                        </button>

                        <!--<button name="action_view_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart">

                            <field name="order_count"
                                   widget="statinfo"
                                   string="Sales Orders"/>

                        </button>-->

                    </div>

                    <group>
                        <h1>
                            <field name="code"/>
                        </h1>
                    </group>

                    <!-- Individual / Company -->
                   <group>
                        <field name="company_type"
                               widget="radio"
                               options="{'horizontal': true}"/>
                    </group>

                    <!-- Name -->
                    <h1>
                        <field name="name" placeholder="e.g. Lumber Inc"/>
                    </h1>

                    <!-- Arabic Name -->
                    <group>
                        <field name="name_ar"/>
                    </group>

                    <!-- Two Columns -->
                    <group>

                        <!-- Left -->
                        <group>

                            <field name="street"/>

                            <field name="district"/>

                            <field name="city"/>

                            <field name="state_id"/>

                            <field name="zip"/>

                            <field name="country_id"/>

                            <field name="building_number"/>

                            <field name="plot_identification"/>

                        </group>

                        <!-- Right -->

                        <group>

                            <field name="vat"/>

                            <field name="uf_number"/>

                            <field name="phone"/>

                            <field name="mobile"/>

                            <field name="email"/>

                            <field name="website"
                                   placeholder="e.g. https://www.odoo.com"/>

                            <field name="lang"/>

                        </group>

                    </group>

                </sheet>

                <chatter/>

            </form>
        </field>

    </record>


    <!-- Kanban View -->

    <record id="sup_customer_kanban" model="ir.ui.view">
        <field name="name">sup.sales.customer.kanban</field>
        <field name="model">sup.sales.customer</field>
        <field name="arch" type="xml">

            <kanban sample="1">

                <field name="code"/>
                <field name="name"/>
                <field name="name_ar"/>
                <field name="company_type"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="vat"/>
                <field name="quotation_count"/>

                <templates>

                    <t t-name="card">

                        <div class="oe_kanban_card oe_kanban_global_click p-3">

                            <!-- Customer Code -->
                            <div class="text-muted fw-bold">
                                <field name="code"/>
                            </div>

                            <!-- Customer Name -->
                            <div class="fs-5 fw-bold mt-1">
                                <field name="name"/>
                            </div>

                            <!-- Arabic Name -->
                            <div t-if="record.name_ar.raw_value"
                                 class="text-muted">
                                <field name="name_ar"/>
                            </div>

                            <!-- Company Type -->
                            <div class="mt-2">
                                <span class="badge text-bg-info"
                                      t-if="record.company_type.raw_value == 'company'">
                                    Company
                                </span>

                                <span class="badge text-bg-secondary"
                                      t-if="record.company_type.raw_value == 'person'">
                                    Individual
                                </span>
                            </div>

                            <hr/>

                            <!-- Contact -->
                            <div t-if="record.phone.raw_value">
                                <i class="fa fa-phone me-1"/>
                                <field name="phone"/>
                            </div>

                            <div t-if="record.mobile.raw_value">
                                <i class="fa fa-mobile me-1"/>
                                <field name="mobile"/>
                            </div>

                            <div t-if="record.email.raw_value">
                                <i class="fa fa-envelope me-1"/>
                                <field name="email"/>
                            </div>

                            <div t-if="record.city.raw_value">
                                <i class="fa fa-map-marker me-1"/>
                                <field name="city"/>
                                <t t-if="record.country_id.raw_value">
                                    ,
                                    <field name="country_id"/>
                                </t>
                            </div>

                            <div t-if="record.vat.raw_value">
                                <strong>VAT:</strong>
                                <field name="vat"/>
                            </div>

                            <hr/>

                            <!-- Statistics -->
                            <div class="d-flex justify-content-between align-items-center">

                                <span class="text-muted">
                                    Quotations
                                </span>

                                <span class="badge rounded-pill text-bg-primary">
                                    <field name="quotation_count"/>
                                </span>

                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>
    </record>

    <!-- Action -->

    <record id="action_sup_customer" model="ir.actions.act_window">

        <field name="name">Customers</field>

        <field name="res_model">sup.sales.customer</field>

        <field name="view_mode">kanban,list,form</field>

    </record>

</odoo>