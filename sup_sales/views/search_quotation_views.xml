<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sup_quotation_search" model="ir.ui.view">
        <field name="name">sup.sales.quotation.search</field>
        <field name="model">sup.sales.quotation</field>
        <field name="arch" type="xml">

            <search string="Search Quotations">

                <field name="name"/>
                <field name="customer_id"/>
                <field name="salesman_id"/>

                <separator/>

                <filter string="Quotation"
                        name="draft"
                        domain="[('state','=','draft')]"/>

                <filter string="Quotation Sent"
                        name="sent"
                        domain="[('state','=','sent')]"/>

                <filter string="Sales Orders"
                        name="sale"
                        domain="[('state','=','sale')]"/>

                <filter string="Cancelled"
                        name="cancel"
                        domain="[('state','=','cancel')]"/>

                <separator/>

                <group expand="0" string="Group By">

                    <filter string="Customer"
                            name="group_customer"
                            context="{'group_by':'customer_id'}"/>

                    <filter string="Salesperson"
                            name="group_salesman"
                            context="{'group_by':'salesman_id'}"/>

                    <filter string="State"
                            name="group_state"
                            context="{'group_by':'state'}"/>

                    <filter string="Quotation Date"
                            name="group_date"
                            context="{'group_by':'quotation_date'}"/>

                </group>

            </search>

        </field>
    </record>

    <record id="sup_quotation_kanban" model="ir.ui.view">
        <field name="name">sup.sales.quotation.kanban</field>
        <field name="model">sup.sales.quotation</field>

        <field name="arch" type="xml">

            <kanban default_group_by="state">

                <field name="name"/>
                <field name="customer_id"/>
                <field name="quotation_date"/>
                <field name="amount_total"/>
                <field name="salesman_id"/>
                <field name="state"/>

                <templates>

                    <t t-name="card">

                        <div class="oe_kanban_card">

                            <div class="fw-bold fs-5 mb-2">
                                <field name="name"/>
                            </div>

                            <div>
                                <strong>Customer</strong><br/>
                                <field name="customer_id"/>
                            </div>

                            <div class="mt-2">
                                <strong>Date</strong><br/>
                                <field name="quotation_date"/>
                            </div>

                            <div class="mt-2">
                                <strong>Salesperson</strong><br/>
                                <field name="salesman_id"/>
                            </div>

                            <div class="mt-3">
                                <strong>Total</strong><br/>
                                <field name="amount_total"/>
                            </div>

                           <div class="mt-3">

                            <span t-if="record.state.raw_value == 'draft'"
                                  class="badge rounded-pill text-bg-info">
                                <field name="state"/>
                            </span>

                            <span t-if="record.state.raw_value == 'sent'"
                                  class="badge rounded-pill text-bg-warning">
                                <field name="state"/>
                            </span>

                            <span t-if="record.state.raw_value == 'sale'"
                                  class="badge rounded-pill text-bg-success">
                                <field name="state"/>
                            </span>

                            <span t-if="record.state.raw_value == 'cancel'"
                                  class="badge rounded-pill text-bg-danger">
                                <field name="state"/>
                            </span>

                        </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>
    </record>

</odoo>