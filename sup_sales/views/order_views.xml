<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="sup_order_tree" model="ir.ui.view">
        <field name="name">sup.sales.order.list</field>
        <field name="model">sup.sales.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="total_amount"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="sup_order_form" model="ir.ui.view">
        <field name="name">sup.sales.order.form</field>
        <field name="model">sup.sales.order</field>
        <field name="arch" type="xml">
            <form>

                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>

                    <h1>
                        <field name="name"/>
                    </h1>

                    <group>
                        <field name="customer_id"/>
                        <field name="quotation_id"/>
                        <field name="date"/>
                    </group>

                    <notebook>
                        <page string="Products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="qty"/>
                                    <field name="price"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_amount"/>
                    </group>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sup_order" model="ir.actions.act_window">
        <field name="name">Sales Orders</field>
        <field name="res_model">sup.sales.order</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>