<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- AGED RECEIVABLE -->
    <!-- ===================================================== -->

    <!-- Existing period5: Older -> 121-150 -->
    <record id="account_reports.aged_receivable_report_period5"
            model="account.report.column">
        <field name="name">121-150</field>
        <field name="sequence">101</field>
    </record>

    <!-- New period6: 151-180 -->
    <record id="custom_aged_receivable_report_period6"
            model="account.report.column">
        <field name="name">151-180</field>
        <field name="expression_label">period6</field>
        <field name="sequence">102</field>
        <field name="report_id"
               ref="account_reports.aged_receivable_report"/>
        <field name="sortable" eval="False"/>
        <field name="figure_type">monetary</field>
        <field name="blank_if_zero" eval="True"/>
    </record>

    <!-- New period7: Older 181+ -->
    <record id="custom_aged_receivable_report_period7"
            model="account.report.column">
        <field name="name">Older</field>
        <field name="expression_label">period7</field>
        <field name="sequence">103</field>
        <field name="report_id"
               ref="account_reports.aged_receivable_report"/>
        <field name="sortable" eval="False"/>
        <field name="figure_type">monetary</field>
        <field name="blank_if_zero" eval="True"/>
    </record>


    <!-- ===================================================== -->
    <!-- AGED PAYABLE -->
    <!-- ===================================================== -->

    <!-- Existing period5: Older -> 121-150 -->
