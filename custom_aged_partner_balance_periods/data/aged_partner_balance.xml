        <field name="sortable" eval="False"/>
        <field name="figure_type">monetary</field>
        <field name="blank_if_zero" eval="True"/>
    </record>


    <!-- ===================================================== -->
    <!-- AGED RECEIVABLE EXPRESSIONS -->
    <!-- ===================================================== -->

    <record id="custom_aged_receivable_line_period6"
            model="account.report.expression">
        <field name="report_line_id"
               ref="account_reports.aged_receivable_line"/>
        <field name="label">period6</field>
        <field name="engine">custom</field>
        <field name="formula">
            _report_custom_engine_aged_receivable
        </field>
        <field name="subformula">period6</field>
        <field name="auditable" eval="True"/>
    </record>

    <record id="custom_aged_receivable_line_period7"
            model="account.report.expression">
        <field name="report_line_id"
               ref="account_reports.aged_receivable_line"/>
