<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_account_payment_form_exchange_rate" model="ir.ui.view">

        <field name="name">account.payment.exchange.rate.form</field>

        <field name="model">account.payment</field>

        <field name="inherit_id"
               ref="account.view_account_payment_form"/>


        <field name="arch" type="xml">

            <!-- إضافة السطر تحت مبلغ الدفع -->
            <xpath expr="//div[@name='amount_div']" position="after">

                <div class="text-muted small mt-1 text-end"
                     invisible="currency_id == company_currency_id">

                    <span>
                        1
                        <field name="company_currency_id"
                               nolabel="1"
                               readonly="1"
                               class="oe_inline"/>

                        =
                    </span>


                    <field name="exchange_rate"
                           nolabel="1"
                           class="oe_inline"
                           readonly="state != 'draft'"/>


                    <span>
                        <field name="currency_id"
                               nolabel="1"
                               readonly="1"
                               class="oe_inline"/>
                    </span>


                    <button name="action_refresh_exchange_rate"
                            type="object"
                            class="btn btn-link btn-sm p-0 ms-1"
                            title="Refresh">

                        <i class="fa fa-refresh"/>

                    </button>

                </div>

            </xpath>
        </field>

    </record>


</odoo>