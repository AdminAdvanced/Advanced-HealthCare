<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_partner_form_sale_credit_control" model="ir.ui.view">
        <field name="name">res.partner.form.sale.credit.control</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

             <xpath expr="//field[@name='credit_limit']/ancestor::group[1]" position="inside">
                 <field name="confirmed_uninvoiced_sales"/>
                 <field name="available_credit"/>
            </xpath>

        </field>
    </record>
</odoo>