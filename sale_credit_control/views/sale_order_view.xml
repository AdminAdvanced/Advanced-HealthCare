<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_order_form_inherit_approval" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- زر الموافقة للمدير يظهر فقط في حالة انتظار الموافقة -->
                <button name="action_approve_order"
                        string="Approve Order"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'waiting_approval'"/>
            </xpath>
        </field>
    </record>
</odoo>