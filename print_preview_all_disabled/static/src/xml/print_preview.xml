<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="print_preview_all.PrintPreviewDialog">
        <Dialog title="'Print Preview'" size="'extra-large'">

            <div
                style="
                    width: 100%;
                    height: 75vh;
                    min-height: 500px;
                    background: #525659;
                "
            >
                <iframe
                    t-ref="pdfFrame"
                    style="
                        width: 100%;
                        height: 100%;
                        border: none;
                        display: block;
                    "
                />
            </div>

            <t t-set-slot="footer">

                <button
                    type="button"
                    class="btn btn-primary"
                    t-on-click="onPrint"
                >
                    <i class="fa fa-print me-1"/>
                    Print
                </button>

                <button
                    type="button"
                    class="btn btn-secondary"
                    t-on-click="onDownload"
                >
                    <i class="fa fa-download me-1"/>
                    Download
                </button>

                <button
                    type="button"
                    class="btn btn-secondary"
                    t-on-click="props.close"
                >
                    Close
                </button>

            </t>

        </Dialog>
    </t>

</templates>