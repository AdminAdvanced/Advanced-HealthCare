<odoo>
  <data>
      <record id="view_partner_form_inherit_contact_code_v2" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.contact.code.v2</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="priority">300</field>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='category_id']" position="after">
                    <field name="contact_code"/>
                </xpath>
                <xpath expr="//field[@name='street']" position="after">
                    <field name="city_id" placeholder="City" class=".o_address_city" style="width:33%"/>
                </xpath>
                <xpath expr="//field[@name='city']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

            </field>
      </record>

