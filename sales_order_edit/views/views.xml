<odoo>
    <record id="view_stock_return_picking_form_inherit_credit_note" model="ir.ui.view">
        <field name="name">stock.return.picking.form.inherit.credit.note</field>
        <field name="model">stock.return.picking</field>
        <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer" position="before">
                <group>
                    <field name="create_credit_note" widget="boolean"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
